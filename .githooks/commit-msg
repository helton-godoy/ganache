#!/bin/bash
# Hook: commit-msg
# Objetivo: Enforce Conventional Commits

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Regex para Conventional Commits
# Tipos permitidos: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
PATTERN="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?: .{1,50}"

if [[ ! "$COMMIT_MSG" =~ $PATTERN ]]; then
	echo "❌ [ERRO] Mensagem de commit inválida!"
	echo "----------------------------------------------------------------"
	echo "O projeto segue o padrão Conventional Commits."
	echo "Formatos aceitos:"
	echo "  feat(escopo): descrição curta"
	echo "  fix: descrição do erro corrigido"
	echo "  docs: alteração em documentação"
	echo ""
	echo "Sua mensagem: $COMMIT_MSG"
	echo "----------------------------------------------------------------"
	exit 1
fi
