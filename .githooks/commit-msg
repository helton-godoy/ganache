#!/bin/bash
# Hook: commit-msg
# Objetivo: Enforce Conventional Commits

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Regex para Conventional Commits
# Tipos permitidos: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test
PATTERN="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?: .{1,50}"

if [[ ! "$COMMIT_MSG" =~ $PATTERN ]]; then
	echo "❌ [ERRO] Mensagem de commit inválida!"
	echo "----------------------------------------------------------------"
	echo "O projeto segue o padrão Conventional Commits."
	echo "Formatos aceitos:"
	echo "  feat(escopo): descrição curta"
	echo "  fix: descrição do erro corrigido"
	echo "  docs: alteração em documentação"
	echo ""
	echo "Sua mensagem: $COMMIT_MSG"
	echo "----------------------------------------------------------------"
	exit 1
fi

# Extração do tipo da mensagem
COMMIT_TYPE=$(echo "$COMMIT_MSG" | sed -n 's/^\([a-zA-Z]*\).*/\1/p')

# Classificação das mudanças do commit
COMMIT_CHANGES=$(git diff --cached --name-status)
if [ -z "$COMMIT_CHANGES" ]; then
    # Se não conseguir obter mudanças, pular validação
    exit 0
fi

# Lógica simplificada de classificação baseada em git-classify.sh
HAS_FEAT=false
HAS_FIX=false
HAS_DOCS=false
HAS_CHORE=false
HAS_TEST=false
HAS_CI=false
HAS_STYLE=false
HAS_GOV=false

while IFS= read -r line; do
    FILE=$(echo "$line" | awk '{print $2}')
    if [[ "$FILE" == *"src/"* ]] || [[ "$FILE" == *"core/"* ]]; then
        HAS_FEAT=true
    elif [[ "$FILE" == *"tests/"* ]] || [[ "$FILE" == *".spec.ts" ]]; then
        HAS_TEST=true
    elif [[ "$FILE" == *"docs/"* ]] || [[ "$FILE" == *".md" ]]; then
        HAS_DOCS=true
    elif [[ "$FILE" == *".github/"* ]]; then
        HAS_CI=true
    elif [[ "$FILE" == *".bmad/"* ]] || [[ "$FILE" == *".agent/"* ]]; then
        HAS_GOV=true
    elif [[ "$FILE" == *".css" ]] || [[ "$FILE" == *".scss" ]]; then
        HAS_STYLE=true
    else
        HAS_CHORE=true
    fi
done <<< "$COMMIT_CHANGES"

# Validação de consistência
case "$COMMIT_TYPE" in
    feat)
        if [ "$HAS_FEAT" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'feat' esperado para mudanças em código fonte (src/, core/)."
            exit 1
        fi
        ;;
    fix)
        if [ "$HAS_FEAT" = false ] && [ "$HAS_FIX" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'fix' esperado para correções em código."
            exit 1
        fi
        ;;
    docs)
        if [ "$HAS_DOCS" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'docs' esperado para mudanças em documentação."
            exit 1
        fi
        ;;
    test)
        if [ "$HAS_TEST" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'test' esperado para mudanças em testes."
            exit 1
        fi
        ;;
    ci)
        if [ "$HAS_CI" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'ci' esperado para mudanças em CI/CD."
            exit 1
        fi
        ;;
    style)
        if [ "$HAS_STYLE" = false ]; then
            echo "❌ [CONSISTÊNCIA] Tipo 'style' esperado para mudanças em estilos."
            exit 1
        fi
        ;;
    chore)
        # Chore é genérico, permitir
        ;;
    *)
        # Outros tipos permitidos
        ;;
esac
