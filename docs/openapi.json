  "paths": {
    "/api/v1/acl/principals": {
      "get": {
        "tags": [],
        "summary": "Search Active Directory for users and groups",
        "description": "@ref Story-4.2 - Searchable AD principal listing endpoint",
        "operationId": "search_ad_principals",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "principal_type",
            "in": "query",
            "description": "Filter: 'user' or 'group'",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (default: 0)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size (default: 50, max: 1000)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of AD principals",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdSearchResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to query AD"
          }
        }
      }
    },
    "/api/v1/acl/{path}": {
      "get": {
        "tags": [],
        "summary": "Get ACL for a filesystem path",
        "description": "@ref Story-4.2 - ACL retrieval endpoint",
        "operationId": "get_acl",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "Filesystem path (URL-encoded)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Output format: 'compact' or 'verbose' (default: compact)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ACL retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAclResponse"
                }
              }
            }
          },
          "404": {
            "description": "Path not found"
          },
          "500": {
            "description": "Failed to get ACL"
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "Set ACL for a filesystem path",
        "description": "@ref Story-4.2 - ACL modification endpoint\n@ref Story-4.3 - Added recursive support",
        "operationId": "set_acl",
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "description": "Filesystem path (URL-encoded)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAclRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "ACL set successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetAclResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ACL data"
          },
          "404": {
            "description": "Path not found"
          },
          "500": {
            "description": "Failed to set ACL"
          }
        }
      }
    },
    "/api/v1/ad/join": {
      "post": {
        "tags": [],
        "summary": "Join Active Directory domain",
        "description": "# Purpose\nJoins the Ganache appliance to an Active Directory domain using the provided credentials\n\n# Arguments\n* `user` - Authenticated user making the request (extracted from X-Auth-User header)\n* `payload` - AD join request containing domain name, credentials, and DNS settings\n\n# Returns\nJSON response with join status or error message\n\n@ref Story-4.1 - API endpoint for AD domain join",
        "operationId": "join_ad_domain",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdJoinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully joined domain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdJoinResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "500": {
            "description": "Failed to join domain"
          }
        }
      }
    },
    "/api/v1/ad/leave": {
      "post": {
        "tags": [],
        "summary": "Leave Active Directory domain",
        "description": "# Purpose\nRemoves the Ganache appliance from the current AD domain\n\n# Arguments\n* `user` - Authenticated user making the request\n\n@ref Story-4.1 - Leave AD domain functionality",
        "operationId": "leave_ad_domain",
        "responses": {
