  "components": {
    "schemas": {
      "AceInheritFlags": {
        "type": "object",
        "description": "ACE inheritance flags\n\n# Purpose\nControls how ACEs are inherited by child files and directories\n\n@ref Story-4.2 - ACL inheritance spec",
        "required": [
          "file_inherit",
          "dir_inherit",
          "inherit_only",
          "no_propagate",
          "successful_access",
          "failed_access",
          "inherited"
        ],
        "properties": {
          "dir_inherit": {
            "type": "boolean",
            "description": "Inherit to directories (d)"
          },
          "failed_access": {
            "type": "boolean",
            "description": "Audit failed access - CIFS only (F)"
          },
          "file_inherit": {
            "type": "boolean",
            "description": "Inherit to files (f)"
          },
          "inherit_only": {
            "type": "boolean",
            "description": "Apply only to future objects, not this directory (i)"
          },
          "inherited": {
            "type": "boolean",
            "description": "Indicates ACE was inherited (I)"
          },
          "no_propagate": {
            "type": "boolean",
            "description": "Inherit only to first level (n)"
          },
          "successful_access": {
            "type": "boolean",
            "description": "Audit successful access - CIFS only (S)"
          }
        }
      },
      "AcePrincipal": {
        "oneOf": [
          {
            "type": "string",
            "description": "File/directory owner (owner@)",
            "enum": [
              "owner"
            ]
          },
          {
            "type": "string",
            "description": "Owning group (group@)",
            "enum": [
              "group"
            ]
          },
          {
            "type": "string",
            "description": "Everyone else (everyone@)",
            "enum": [
              "everyone"
            ]
          },
          {
            "type": "object",
            "description": "Specific user by name or UID (user:name)",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "type": "string",
                "description": "Specific user by name or UID (user:name)"
              }
            }
          },
          {
            "type": "object",
            "description": "Specific group by name or GID (group:name)",
            "required": [
              "named_group"
            ],
            "properties": {
              "named_group": {
                "type": "string",
                "description": "Specific group by name or GID (group:name)"
              }
            }
          }
        ],
        "description": "ACE Principal (who receives the permission)\n\n# Purpose\nRepresents the principal (user/group) that an ACE applies to\n\n@ref Story-4.2 - ACE principal enum"
      },
      "AceType": {
        "type": "string",
        "description": "Type of Access Control Entry (ACE)\n\n# Purpose\nDefines the action type for an ACE (allow, deny, audit)\n\n@ref Story-4.2 - ACE type enum",
        "enum": [
          "allow",
          "deny",
          "audit",
          "alarm"
        ]
      },
      "AdJoinRequest": {
        "type": "object",
        "description": "Request payload for joining an Active Directory domain\n\n# Purpose\nContains all necessary information to join a Ganache appliance to an AD domain\n\n@ref Story-4.1 - Active Directory domain join request model",
        "required": [
          "domain_name",
          "username",
          "password",
          "dns_servers"
        ],
        "properties": {
          "dns_servers": {
            "type": "string",
            "description": "DNS server IP addresses (comma-separated, e.g., \"192.168.1.1,192.168.1.2\")"
          },
          "domain_name": {
            "type": "string",
            "description": "Active Directory domain name (e.g., \"corp.example.com\")"
          },
          "organizational_unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional organizational unit for computer account (e.g., \"OU=Servers,DC=corp,DC=example,DC=com\")"
          },
          "password": {
            "type": "string",
            "description": "Domain administrator password (encrypted in transit via HTTPS)"
          },
          "username": {
            "type": "string",
            "description": "Domain administrator username"
          }
        }
      },
      "AdJoinResponse": {
        "type": "object",
        "description": "Response after joining AD domain\n\n# Purpose\nProvides feedback about AD join operation success/failure\n\n@ref Story-4.1 - Active Directory domain join response model",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "current_domain": {
            "type": [
              "string",
              "null"
            ],
            "description": "Current AD domain name if successfully joined"
          },
          "message": {
            "type": "string",
            "description": "Detailed status message"
          },
          "success": {
            "type": "boolean",
            "description": "Success status of the join operation"
          }
        }
      },
      "AdPrincipal": {
        "type": "object",
        "description": "Active Directory user or group principal\n\n# Purpose\nRepresents an AD principal (user or group) for ACL assignment\n\n@ref Story-4.2 - ACL principal model",
        "required": [
          "name",
          "principal_type",
          "distinguished_name"
        ],
        "properties": {
          "distinguished_name": {
            "type": "string",
            "description": "Full distinguished name (DN) from LDAP"
          },
          "name": {
            "type": "string",
            "description": "Principal name (e.g., \"john.doe\" or \"Finance-Group\")"
          },
          "principal_type": {
            "$ref": "#/components/schemas/AdPrincipalType",
            "description": "Principal type (user or group)"
          },
          "sid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Security Identifier (SID) for the principal"
          }
        }
      },
      "AdPrincipalType": {
        "type": "string",
