  "components": {
    "schemas": {
      "AdJoinRequest": {
        "type": "object",
        "description": "Request payload for joining an Active Directory domain\n\n# Purpose\nContains all necessary information to join a Ganache appliance to an AD domain\n\n@ref Story-4.1 - Active Directory domain join request model",
        "required": [
          "domain_name",
          "username",
          "password",
          "dns_servers"
        ],
        "properties": {
          "dns_servers": {
            "type": "string",
            "description": "DNS server IP addresses (comma-separated, e.g., \"192.168.1.1,192.168.1.2\")"
          },
          "domain_name": {
            "type": "string",
            "description": "Active Directory domain name (e.g., \"corp.example.com\")"
          },
          "organizational_unit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional organizational unit for computer account (e.g., \"OU=Servers,DC=corp,DC=example,DC=com\")"
          },
          "password": {
            "type": "string",
            "description": "Domain administrator password (encrypted in transit via HTTPS)"
          },
          "username": {
            "type": "string",
            "description": "Domain administrator username"
          }
        }
      },
      "AdJoinResponse": {
        "type": "object",
        "description": "Response after joining AD domain\n\n# Purpose\nProvides feedback about AD join operation success/failure\n\n@ref Story-4.1 - Active Directory domain join response model",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "current_domain": {
            "type": [
              "string",
              "null"
            ],
            "description": "Current AD domain name if successfully joined"
          },
          "message": {
            "type": "string",
            "description": "Detailed status message"
          },
          "success": {
            "type": "boolean",
            "description": "Success status of the join operation"
          }
        }
      },
      "AdStatus": {
        "type": "object",
        "description": "Active Directory status information\n\n# Purpose\nProvides current AD join state and service health\n\n@ref Story-4.1 - Active Directory status model",
        "required": [
          "is_joined",
          "service_status"
        ],
        "properties": {
          "domain_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Current domain name if joined"
          },
          "is_joined": {
            "type": "boolean",
            "description": "Whether the system is currently joined to a domain"
          },
          "last_sync": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last successful sync timestamp (ISO 8601 format)"
          },
          "service_status": {
            "type": "string",
            "description": "AD service status: \"active\", \"inactive\", \"error\""
          }
        }
      },
      "BootEnvironment": {
        "type": "object",
        "required": [
          "name",
          "active",
          "created",
          "space",
          "keep"
        ],
        "properties": {
          "active": {
            "type": "string"
          },
          "created": {
            "type": "string"
          },
          "keep": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "space": {
            "type": "string"
          }
        }
      },
      "BootEnvironmentActivation": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ClusterConfig": {
        "type": "object",
        "required": [
          "mode",
          "node_id",
          "peer_ip",
          "vip_address",
          "network_interface"
        ],
        "properties": {
          "dev_mode": {
            "type": "boolean"
          },
          "drbd_resource": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "network_interface": {
            "type": "string"
          },
          "node_id": {
            "type": "integer",
            "format": "int32"
          },
          "peer_ip": {
            "type": "string"
          },
          "vip_address": {
            "type": "string"
          }
        }
      },
      "ClusterStatus": {
        "type": "object",
        "required": [
          "state",
          "progress",
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "format": "float"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "DatasetConfig": {
        "type": "object",
        "required": [
          "pool_name",
          "name"
        ],
        "properties": {
          "compression": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "pool_name": {
            "type": "string"
          },
          "quota": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DatasetInfo": {
        "type": "object",
        "required": [
          "pool",
          "name",
          "mountpoint",
          "used",
          "available",
          "compression",
          "quota"
        ],
        "properties": {
          "available": {
            "type": "string"
          },
          "compression": {
            "type": "string"
          },
          "mountpoint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          },
          "quota": {
            "type": "string"
          },
          "used": {
            "type": "string"
          }
        }
      },
      "DeleteDatasetPayload": {
        "type": "object",
        "required": [
          "pool",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pool": {
            "type": "string"
          }
        }
      },
      "DiskInfo": {
        "type": "object",
        "required": [
          "id",
          "serial",
          "size",
          "status",
          "node_id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "serial": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "GitCommit": {
        "type": "object",
        "description": "GitCommit represents a single commit in the configuration repository\n\n# Purpose\nProvides commit metadata for the configuration timeline UI\n\n@ref Story-3.2 - Implements GitCommit model for configuration audit timeline",
        "required": [
          "id",
          "author",
          "date",
          "message",
          "files_changed"
        ],
        "properties": {
          "author": {
            "type": "string",
            "description": "Author of the commit"
          },
          "date": {
            "type": "string",
            "description": "ISO 8601 formatted date"
          },
          "files_changed": {
            "type": "integer",
            "format": "int32",
            "description": "Number of files changed in this commit",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "description": "The commit hash (SHA-1)"
          },
          "message": {
            "type": "string",
            "description": "Commit message"
          }
        }
      },
      "GitDiff": {
        "type": "object",
        "description": "GitDiff represents the diff content for a specific commit\n\n# Purpose\nProvides unified diff view for commit changes in the UI\n\n@ref Story-3.2 - Implements GitDiff model for visual comparison of configuration changes",
        "required": [
          "commit_id",
          "files"
        ],
        "properties": {
          "commit_id": {
            "type": "string",
            "description": "The commit hash this diff belongs to"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GitFileDiff"
            },
            "description": "List of changed files with their diffs"
          }
        }
      },
      "GitFileDiff": {
        "type": "object",
        "description": "GitFileDiff represents changes to a single file\n\n# Purpose\nContains file-level diff metadata and content\n\n@ref Story-3.2 - File-level diff details for expandable sections in CommitDiffModal",
        "required": [
          "filename",
          "additions",
          "deletions",
          "diff_content"
        ],
        "properties": {
          "additions": {
            "type": "integer",
            "format": "int32",
            "description": "Number of lines added",
            "minimum": 0
          },
          "deletions": {
            "type": "integer",
            "format": "int32",
            "description": "Number of lines deleted",
            "minimum": 0
          },
          "diff_content": {
            "type": "string",
            "description": "Unified diff format content"
          },
          "filename": {
            "type": "string",
            "description": "Filename relative to repository root"
          }
        }
      },
      "HardwareInfo": {
        "type": "object",
        "required": [
          "has_raid"
        ],
        "properties": {
          "controller_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the detected controller, if any"
          },
          "has_raid": {
            "type": "boolean",
            "description": "True if a supported RAID controller is detected (e.g., PERC 6/i)"
          }
        }
      },
      "PoolConfig": {
        "type": "object",
        "required": [
          "name",
          "device",
