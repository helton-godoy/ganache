    "/api/v1/config/history": {
      "get": {
        "tags": [],
        "summary": "Get configuration history with pagination and filtering",
        "description": "@ref Story-3.2 - Fetch paginated list of configuration commits",
        "operationId": "get_config_history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of commits to return (default: 50, max: 200)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of commits to skip for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "author_filter",
            "in": "query",
            "description": "Filter commits by author name",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "description": "Filter commits from this date (ISO 8601)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "description": "Filter commits until this date (ISO 8601)",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Configuration commit history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GitCommit"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Configuration repository not yet created"
          }
        }
      }
    },
    "/api/v1/config/history/{commit_id}/diff": {
      "get": {
        "tags": [],
        "summary": "Get diff for a specific commit",
        "description": "@ref Story-3.2 - Visual comparison of configuration changes",
        "operationId": "get_commit_diff",
        "parameters": [
          {
            "name": "commit_id",
            "in": "path",
            "description": "Commit hash ID",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commit diff with file changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitDiff"
                }
              }
            }
          },
          "404": {
            "description": "Commit not found"
          },
          "503": {
            "description": "Configuration repository not yet created"
          }
        }
      }
    },
    "/api/v1/config/rollback": {
      "post": {
        "tags": [],
        "summary": "Rollback configuration to a specific commit",
        "description": "# Purpose\nOne-click rollback of configuration to a previous state with audit trail\n\n@ref Story-3.3 - Implements rollback endpoint for configuration time-machine",
        "operationId": "rollback_config",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RollbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Configuration rolled back successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RollbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid commit ID or request"
          },
          "503": {
            "description": "Configuration repository not yet created"
          }
        }
      }
    },
